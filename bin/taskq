#!/usr/bin/env python3
"""taskq：任务队列和调度的命令行（2026-11-04）。命令表和约定见 README.md。

找项目（--project / TASKQ_PROJECT / 从当前目录往上找 .taskq.toml）要在 import 核心的模块之前：cfg.py 在 import 时读
TASKQ_REPO、TASKQ_CONFIG。子命令在进程内调用各模块的 main(argv)；bash 脚本用 exec。
"""
import importlib
import inspect
import os
import subprocess
import sys
import time

CORE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DIRS = [os.path.join(CORE, d) for d in ("queue", "sites", "monitor", "sync")]
HELP = ("-h", "--help")
OK, ERR, USAGE = 0, 1, 2


def say(msg):
    print(f"taskq：{msg}", file=sys.stderr)


def version():
    p = os.path.join(CORE, "VERSION")  # 代码包里写好的
    if os.path.isfile(p):
        return open(p).read().strip()
    r = subprocess.run(["git", "-C", CORE, "describe", "--always", "--dirty"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else "unknown"


# ---------------- 调用模块和脚本 ----------------
def paths():
    for d in reversed(DIRS):
        if d not in sys.path:
            sys.path.insert(0, d)


def load(mod):
    """核心的模块。没有这个模块 → None。"""
    paths()
    try:
        return importlib.import_module(mod)
    except ModuleNotFoundError as e:
        if e.name == mod:
            return None
        raise


def exit_code(rc):
    if rc is None or rc is True:
        return OK
    if isinstance(rc, int):
        return rc
    print(rc, file=sys.stderr)  # sys.exit("说明")
    return ERR


def run(fn, prog, argv):
    """fn() 跑的时候 sys.argv[0] = prog（argparse 的帮助里显示成 taskq 的子命令）。"""
    old = sys.argv
    sys.argv = [prog, *argv]
    try:
        rc = fn()
    except SystemExit as e:
        rc = e.code
    finally:
        sys.argv = old
    return exit_code(rc)


def call(mod, argv, prog):
    """mod.main(argv)（没有参数的 main() 读 sys.argv）。"""
    m = load(mod)
    if m is None or not hasattr(m, "main"):
        return missing(f"{mod}.py 的命令行", argv, prog)
    takes = bool(inspect.signature(m.main).parameters)
    return run((lambda: m.main(argv)) if takes else m.main, prog, argv)


def missing(what, argv, prog):
    if set(argv) & set(HELP):
        print(f"用法：{prog} …\n\n这个版本的 taskq 还没有{what}")
        return OK
    say(f"这个版本的 taskq 没有{what}（taskq self update）")
    return ERR


def script(rel, argv, prog):
    """按 python3 <脚本> 的方式在进程内跑（__name__ == "__main__"；不用 runpy：它把 sys.argv[0] 换成文件名）。"""
    import types
    paths()
    p = os.path.join(CORE, rel)
    m = types.ModuleType("__main__")
    m.__file__ = p
    code = compile(open(p, "rb").read(), p, "exec")
    return run(lambda: exec(code, m.__dict__), prog, argv)


def bash(rel, argv, prog):
    sys.stdout.flush()
    sys.stderr.flush()
    os.environ["TASKQ_PROG"] = prog  # 脚本的用法、出错里显示的命令名
    os.execvp("bash", ["bash", os.path.join(CORE, rel), *argv])


# ---------------- 命令 ----------------
class Cmd:
    """一个子命令。own_help：模块自己的 argparse 处理 -h（照样传过去）；否则这里打印 usage / doc，不调用模块。
    project：要用项目的配置。help_in：在哪些参数里找 -h（默认 "--" 以前的全部）。"""

    def __init__(self, summary, fn, usage="", doc="", own_help=False, project=True, help_in=None):
        self.summary, self.fn, self.usage, self.doc = summary, fn, usage, doc
        self.own_help, self.project, self.help_in = own_help, project, help_in

    def wants_help(self, argv):
        if self.own_help:
            return False
        scan = self.help_in(argv) if self.help_in else (argv[:argv.index("--")] if "--" in argv else argv)
        return any(a in HELP for a in scan)

    def help(self, prog):
        out = f"用法：{prog} {self.usage}".rstrip() + f"\n\n{self.summary}"
        return out + (f"\n\n{self.doc.strip()}" if self.doc else "")


class Group:
    def __init__(self, summary, cmds, hidden=False):
        self.summary, self.cmds, self.hidden = summary, cmds, hidden

    def help(self, prog):
        w = max(map(len, self.cmds)) + 2
        lines = [f"用法：{prog} <命令> [参数…]", "", self.summary, "", "命令："]
        lines += [f"  {n:{w}}{c.summary}" for n, c in self.cmds.items()]
        return "\n".join(lines + ["", f"每个命令的说明：{prog} <命令> --help"])


def py(mod, *pre, prog="taskq"):
    """在进程内调用 mod.main([*pre, *argv])。"""
    return lambda argv, _p: call(mod, [*pre, *argv], prog)


def sh(rel):
    return lambda argv, prog: bash(rel, argv, prog)


def cmd_status(argv, prog):
    if "--all" in argv:
        return call("overview", [a for a in argv if a != "--all"], prog)
    return call("taskq", ["status", *argv], "taskq")


def cmd_plan(argv, prog):
    import argparse
    ap = argparse.ArgumentParser(prog=prog, description="只看：按时段开关、送任务（feed → relay）、训完以后（advance）这一轮会做什么")
    ap.add_argument("-n", "--dry-run", "--dry", action="store_true", help="只看（默认就是）")
    ap.parse_args(argv)
    paths()
    import health as H
    import shift
    import feed
    import advance
    from proto import alert_msg
    s = H.gather()
    ev, st = feed.run_all(s, dry=True)
    parts = [("按时段开关（shift）", shift.run(s, dry=True) or ["不动"]),
             ("送任务（feed → relay）", ev + [f"卡住：{alert_msg(v)}" for v in st.values()] or ["不动"]),
             ("训完以后（advance）", advance.describe(*advance.plan(s)))]
    print("\n\n".join(f"== {t}\n" + "\n".join(lines) for t, lines in parts))
    return OK


def cmd_exp(sub):
    def fn(argv, prog):
        E = load("experiments")
        if hasattr(E, "main"):
            return call("experiments", [sub, *argv], prog.rsplit(" ", 1)[0])  # 子命令由 experiments.py 的 argparse 接上
        if sub == "env-of" and len(argv) == 1:
            return run(lambda: print(E.env_of(argv[0])), prog, argv)
        if sub == "name-of" and len(argv) >= 2:
            return run(lambda: print("\n".join(E.names_of(*argv))), prog, argv)
        if sub in ("env-of", "name-of"):
            say(f"用法：{prog} {EXP_USAGE[sub]}")
            return USAGE
        return missing(f" exp {sub}", argv, prog)
    return fn


EXP_USAGE = {"env-of": "<模型文件夹>", "name-of": "<模型文件夹> <名字>…"}


def cmd_machines(argv, prog):
    if argv[:1] == ["show"]:
        return call("cli_json", ["machines-show", *argv[1:]], f"{prog} show")
    return call("mtab", argv, prog)


def cmd_path(argv, prog):
    if len(argv) != 1 or argv[0] not in ("lib", "api", "core"):
        say(f"用法：{prog} lib|api|core")
        return USAGE
    print(CORE if argv[0] == "core" else os.path.join(CORE, "queue"))
    return OK


def git(*args):
    return subprocess.run(["git", "-C", CORE, *args], capture_output=True, text=True)


def cmd_update(argv, prog):
    if argv:
        say(f"用法：{prog}")
        return USAGE
    if git("rev-parse", "--is-inside-work-tree").returncode:
        say(f"{CORE} 不是 git 检出（代码包里的不更新）")
        return ERR
    before = git("rev-parse", "--short", "HEAD").stdout.strip()
    tries, last = 5, ""
    for i in range(1, tries + 1):
        r = git("pull", "--ff-only", "--quiet", "origin", "main")
        if r.returncode == 0:
            break
        last = (r.stderr or r.stdout).strip()
        if i < tries:
            time.sleep(i * 5)
    else:
        say(f"更新失败（试了 {tries} 次），留在 {before}：{last[-300:]}")
        return ERR
    after = git("rev-parse", "--short", "HEAD").stdout.strip()
    say(f"已是最新：{after}" if after == before else f"更新了：{before} → {after}")
    return OK


def cmd_version(argv, prog):
    if argv:
        say(f"用法：{prog}")
        return USAGE
    print(version())
    return OK


def rsync_help(argv):
    return argv[:1]  # 后面的 -h 是 rsync 自己的（--human-readable）


SPEC_DOC = {
    "shell": ("<做法> k=v… | --spec <JSON>", "给 run_task.sh 的 shell 语句（按本机展开）"),
    "done": ("<做法> k=v… | --spec <JSON>", "训完了退出码 0，没训完 1，说明有问题 2，读不了数据目录 5"),
    "resolve": ("<做法> k=v…", "解析好的说明（JSON，一行）"),
    "lookup": ("<key>", "按 key 找任务（先查实验表，再查队列），打印说明（JSON）"),
    "outputs": ("<key> [--sh]", "这个任务的输出（JSON）；--sh：给 archive_task.sh 的 shell 语句"),
    "collect": ("--json < 输入.json", "本机的训练状态（跨版本读用）：输出 @@JSON 一行"),
}

RELAY_DOC = {"export": "中继插件送出：要传的文件、视图、拉回的文件夹（JSON）", "import": "中继插件拉回核对，放进 --dst（JSON）"}

TREE = {
