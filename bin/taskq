SECTIONS = [("队列", ["add", "set", "nice", "show", "status", "stop", "resume", "rm"]),
            ("调度", ["tick", "plan", "boot"]),
            ("执行机和实验", ["site", "exp"]),
            ("其他", ["tunnel", "pueue-add", "pueue-status", "snapshot", "check", "path", "machines", "self"])]


def top_help():
    w = max(len(n) for _, ns in SECTIONS for n in ns) + 2
    lines = ["用法：taskq [--project 目录] <命令> [参数…]", "",
             "任务队列和调度。项目：--project、TASKQ_PROJECT，或从当前目录往上找 .taskq.toml。", ""]
    for title, names in SECTIONS:
        lines.append(f"{title}：")
        lines += [f"  {n:{w}}{TREE[n].summary}" for n in names]
        lines.append("")
    hidden = [n for n, c in TREE.items() if isinstance(c, Group) and c.hidden]
    lines += ["选项：", "  --project 目录   项目的根目录（有 .taskq.toml）", "  --version        版本", "  -h, --help       这页", "",
              f"每个命令的说明：taskq <命令> --help。底层命令（{'、'.join(hidden)}）：taskq <它> --help"]
    return "\n".join(lines)


def unknown(name, choices, prog):
    import difflib
    near = difflib.get_close_matches(name, choices, n=1)
    say(f"不认识的命令 {name}" + (f"，是不是 {prog} {near[0]}？" if near else f"（{prog} --help）"))
    return USAGE


def use_project(explicit):
    """找到项目就导出 TASKQ_REPO / TASKQ_CONFIG / TASKQ_PLUGINS；找不到时照旧（代码包里核心在 <包>/scripts/taskq，cfg.py 按这个布局认仓库）。"""
    sys.path.insert(0, os.path.join(CORE, "queue"))
    import project
    root = project.find(explicit)
    given = explicit or os.environ.get("TASKQ_PROJECT")
    if given and not os.path.isfile(os.path.join(root, project.NAME)):
        raise ValueError(f"{root} 里没有 {project.NAME}")
    if root:
        project.export(root, force=bool(explicit))
    return root


def has_config():
    paths()
    import cfg
    return os.path.isfile(os.path.join(cfg.config_dir(), "machines.py"))


def main(argv):
    explicit = None
    while argv and argv[0].startswith("-"):
        a = argv.pop(0)
        if a in HELP:
            print(top_help())
            return OK
        if a == "--version":
            print(f"taskq {version()}")
            return OK
        if a == "--project" or a.startswith("--project="):
            if a == "--project" and not argv:
                say("--project 要给目录")
                return USAGE
            explicit = a.split("=", 1)[1] if "=" in a else argv.pop(0)
            continue
        say(f"不认识的选项 {a}（taskq --help）")
        return USAGE
    if not argv:
        print(top_help(), file=sys.stderr)
        return USAGE
    name, rest, prog = argv[0], argv[1:], f"taskq {argv[0]}"
    if name == "help":  # taskq help [命令…] = taskq [命令…] --help
        return main([*rest, "--help"]) if rest else main(["--help"])
    node = TREE.get(name)
    if node is None:
        return unknown(name, list(TREE), "taskq")
    if isinstance(node, Group):
        if not rest or rest[0] in HELP:
            print(node.help(prog), file=sys.stdout if rest else sys.stderr)
            return OK if rest else USAGE
        sub, rest = rest[0], rest[1:]
        if sub not in node.cmds:
            return unknown(sub, list(node.cmds), prog)
        node, prog = node.cmds[sub], f"{prog} {sub}"
    if node.wants_help(rest):
        print(node.help(prog))
        return OK
    if not node.project:
        return node.fn(rest, prog)
    try:
        use_project(explicit)
    except ValueError as e:
        say(str(e))
        return USAGE
    if not has_config():
        say("找不到项目：给 --project 目录、设 TASKQ_PROJECT，或在有 .taskq.toml 的目录（或它下面）运行")
        return USAGE
    try:
        return node.fn(rest, prog)
    except (FileNotFoundError, NotADirectoryError) as e:  # 数据目录不在（没建、盘没挂上）：说清是哪个，不打 traceback
        say(f"读不了 {e.filename}：{e.strerror}（数据目录没建，或盘没挂上？）")
        from proto import EXIT
        return EXIT["done_unreadable"]


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(ERR)
