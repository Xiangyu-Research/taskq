SECTIONS = [("queue", ["add", "set", "nice", "show", "log", "status", "stop", "resume", "rm"]),
            ("scheduling", ["tick", "plan", "boot", "problems", "notice", "events", "note", "progress", "notify"]),
            ("executors and experiments", ["site", "env", "smoke", "exp"]),
            ("dependencies", ["who", "dag"]),
            ("other", ["tunnel", "gpu", "pad", "pueue-add", "pueue-status", "check", "db", "path", "machines", "self"])]


def top_help():
    w = max(len(n) for _, ns in SECTIONS for n in ns) + 2
    lines = ["usage: taskq [--project DIR] <command> [args...]", "",
             "Task queue and scheduler. Project: --project, or .taskq.toml up from the current dir.", ""]
    for title, names in SECTIONS:
        lines.append(f"{title}:")
        lines += [f"  {n:{w}}{TREE[n].summary}" for n in names]
        lines.append("")
    hidden = [n for n, c in TREE.items() if isinstance(c, Group) and c.hidden]
    lines += ["options:", "  --project DIR   project root (with .taskq.toml)", "  --version       version", "  -h, --help      this page", "",
              f"help for one command: taskq <command> --help. Low-level commands ({', '.join(hidden)}): taskq <name> --help"]
    return "\n".join(lines)


def unknown(name, choices, prog):
    import difflib
    near = difflib.get_close_matches(name, choices, n=1)
    say(f"unknown command {name}" + (f", did you mean {prog} {near[0]}?" if near else f" ({prog} --help)"))
    return USAGE


def use_project(explicit):
    """When a project is found, export TASKQ_REPO / TASKQ_CONFIG / TASKQ_PLUGINS; when not found, export nothing (in a bundle the core is at <bundle>/scripts/taskq and cfg.py recognizes the repo from that layout)."""
    sys.path.insert(0, os.path.join(CORE, "queue"))
    import project
    root = project.find(explicit)
    given = explicit or os.environ.get("TASKQ_PROJECT")
    if given and not os.path.isfile(os.path.join(root, project.NAME)):
        raise ValueError(f"{root} has no {project.NAME}")
    if root:
        project.export(root, force=bool(explicit))
    return root


def has_config():
    paths()
    import cfg
    return os.path.isfile(os.path.join(cfg.config_dir(), "machines.py"))


def main(argv):
    explicit = None
    while argv and argv[0].startswith("-"):
        a = argv.pop(0)
        if a in HELP:
            print(top_help())
            return OK
        if a == "--version":
            print(f"taskq {version()}")
            return OK
        if a == "--project" or a.startswith("--project="):
            if a == "--project" and not argv:
                say("--project needs a dir")
                return USAGE
            explicit = a.split("=", 1)[1] if "=" in a else argv.pop(0)
            continue
        say(f"unknown option {a} (taskq --help)")
        return USAGE
    if not argv:
        print(top_help(), file=sys.stderr)
        return USAGE
    name, rest, prog = argv[0], argv[1:], f"taskq {argv[0]}"
    if name == "help":  # taskq help [command...] = taskq [command...] --help
        return main([*rest, "--help"]) if rest else main(["--help"])
    node = TREE.get(name)
    if node is None:
        return unknown(name, list(TREE), "taskq")
    if isinstance(node, Group):
        if not rest or rest[0] in HELP:
            print(node.help(prog), file=sys.stdout if rest else sys.stderr)
            return OK if rest else USAGE
        sub, rest = rest[0], rest[1:]
        if sub not in node.cmds:
            return unknown(sub, list(node.cmds), prog)
        node, prog = node.cmds[sub], f"{prog} {sub}"
    if node.wants_help(rest):
        print(node.help(prog))
        return OK
    if not node.project:
        return node.fn(rest, prog)
    try:
        use_project(explicit)
    except ValueError as e:
        say(str(e))
        return USAGE
    if not has_config():
        say("no project found: pass --project DIR, or run in a dir with .taskq.toml (or below it)")
        return USAGE
    try:
        return node.fn(rest, prog)
    except (FileNotFoundError, NotADirectoryError) as e:  # data dir absent (not created, disk not mounted): say which one, no traceback
        say(f"cannot read {e.filename}: {e.strerror} (data dir not created, or disk not mounted?)")
        from proto import EXIT
        return EXIT["done_unreadable"]


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(ERR)
