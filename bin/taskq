#!/usr/bin/env python3
"""taskq: command line for the task queue and scheduler. Commands and conventions are in README.md.

Finding the project (--project / TASKQ_PROJECT / .taskq.toml up from the current dir) must happen before importing core modules: cfg.py reads TASKQ_REPO and TASKQ_CONFIG at import time. Subcommands call each module's main(argv) in-process; bash scripts use exec.
"""
import importlib
import inspect
import os
import subprocess
import sys
import time

CORE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DIRS = [os.path.join(CORE, d) for d in ("queue", "sites", "monitor", "sync")]
HELP = ("-h", "--help")
OK, ERR, USAGE = 0, 1, 2


def say(msg):
    print(f"taskq: {msg}", file=sys.stderr)


def version():
    p = os.path.join(CORE, "VERSION")  # written into the bundle
    if os.path.isfile(p):
        return open(p).read().strip()
    r = subprocess.run(["git", "-C", CORE, "describe", "--always", "--dirty"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else "unknown"


# ---------------- call modules and scripts ----------------
def paths():
    for d in reversed(DIRS):
        if d not in sys.path:
            sys.path.insert(0, d)


def load(mod):
    """A core module. None when the module does not exist."""
    paths()
    try:
        return importlib.import_module(mod)
    except ModuleNotFoundError as e:
        if e.name == mod:
            return None
        raise


def exit_code(rc):
    if rc is None or rc is True:
        return OK
    if isinstance(rc, int):
        return rc
    print(rc, file=sys.stderr)  # sys.exit("message")
    return ERR


def run(fn, prog, argv):
    """Run fn() with sys.argv[0] = prog (argparse help shows it as the taskq subcommand)."""
    old = sys.argv
    sys.argv = [prog, *argv]
    try:
        rc = fn()
    except SystemExit as e:
        rc = e.code
    finally:
        sys.argv = old
    return exit_code(rc)


def call(mod, argv, prog):
    """mod.main(argv) (a main() without parameters reads sys.argv)."""
    m = load(mod)
    if m is None or not hasattr(m, "main"):
        return missing(f"{mod}.py command line", argv, prog)
    takes = bool(inspect.signature(m.main).parameters)
    return run((lambda: m.main(argv)) if takes else m.main, prog, argv)


def missing(what, argv, prog):
    if set(argv) & set(HELP):
        print(f"usage: {prog} ...\n\nthis version of taskq has no {what}")
        return OK
    say(f"this version of taskq has no {what} (taskq self update)")
    return ERR


def script(rel, argv, prog):
    """Run in-process like python3 <script> (__name__ == "__main__"; not runpy: it replaces sys.argv[0] with the file name)."""
    import types
    paths()
    p = os.path.join(CORE, rel)
    m = types.ModuleType("__main__")
    m.__file__ = p
    code = compile(open(p, "rb").read(), p, "exec")
    return run(lambda: exec(code, m.__dict__), prog, argv)


def bash(rel, argv, prog):
    sys.stdout.flush()
    sys.stderr.flush()
    os.environ["TASKQ_PROG"] = prog  # command name shown in the script's usage and errors
    os.execvp("bash", ["bash", os.path.join(CORE, rel), *argv])


# ---------------- commands ----------------
class Cmd:
    """One subcommand. own_help: the module's own argparse handles -h (passed through); otherwise usage / doc is printed here and the module is not called.
    project: needs the project config. help_in: where to look for -h (default everything before "--")."""

    def __init__(self, summary, fn, usage="", doc="", own_help=False, project=True, help_in=None):
        self.summary, self.fn, self.usage, self.doc = summary, fn, usage, doc
        self.own_help, self.project, self.help_in = own_help, project, help_in

    def wants_help(self, argv):
        if self.own_help:
            return False
        scan = self.help_in(argv) if self.help_in else (argv[:argv.index("--")] if "--" in argv else argv)
        return any(a in HELP for a in scan)

    def help(self, prog):
        out = f"usage: {prog} {self.usage}".rstrip() + f"\n\n{self.summary}"
        return out + (f"\n\n{self.doc.strip()}" if self.doc else "")


class Group:
    def __init__(self, summary, cmds, hidden=False):
        self.summary, self.cmds, self.hidden = summary, cmds, hidden

    def help(self, prog):
        w = max(map(len, self.cmds)) + 2
        lines = [f"usage: {prog} <command> [args...]", "", self.summary, "", "commands:"]
        lines += [f"  {n:{w}}{c.summary}" for n, c in self.cmds.items()]
        return "\n".join(lines + ["", f"help for one command: {prog} <command> --help"])


def py(mod, *pre, prog="taskq"):
    """Call mod.main([*pre, *argv]) in-process."""
    return lambda argv, _p: call(mod, [*pre, *argv], prog)


def sh(rel):
    return lambda argv, prog: bash(rel, argv, prog)


def cmd_status(argv, prog):
    tq = load("taskq")
    hub = tq.here() == tq.queue_host()
    if "--all" in argv and ("--json" in argv or not hub):
        return call("overview", [a for a in argv if a != "--all"], prog)
    if hub and not {"--json", "--queue", "--internal"} & set(argv):
        return call("summary", argv, prog)
    return call("taskq", ["status", *[a for a in argv if a != "--queue"]], "taskq")


def cmd_plan(argv, prog):
    import argparse
    ap = argparse.ArgumentParser(prog=prog, description="Dry run: what this round would do for downstream steps (advance) and sending tasks (feed -> relay), in health-check order")
    ap.add_argument("-n", "--dry-run", "--dry", action="store_true", help="dry run (this is the default)")
    ap.parse_args(argv)
    paths()
    import health as H
    import feed
    import advance
    from proto import alert_msg
    s = H.gather()
    after = advance.describe(*advance.plan(s))
    ev, st = feed.run_all(s, dry=True)
    parts = [("downstream steps (advance)", after),
             ("send tasks (feed -> relay)", ev + [f"stuck: {alert_msg(v)}" for v in st.values()] or ["nothing"])]
    print("\n\n".join(f"== {t}\n" + "\n".join(lines) for t, lines in parts))
    return OK


def cmd_exp(sub):
    def fn(argv, prog):
        E = load("experiments")
        if hasattr(E, "main"):
            return call("experiments", [sub, *argv], prog.rsplit(" ", 1)[0])  # subcommand chained to experiments.py's argparse
        if sub == "env-of" and len(argv) == 1:
            return run(lambda: print(E.env_of(argv[0])), prog, argv)
        if sub == "name-of" and len(argv) >= 2:
            return run(lambda: print("\n".join(E.names_of(*argv))), prog, argv)
        if sub in ("env-of", "name-of"):
            say(f"usage: {prog} {EXP_USAGE[sub]}")
            return USAGE
        return missing(f"exp {sub}", argv, prog)
    return fn


EXP_USAGE = {"env-of": "<model dir>", "name-of": "<model dir> <name>..."}


def cmd_machines(argv, prog):
    if argv[:1] == ["show"]:
        return call("cli_json", ["machines-show", *argv[1:]], f"{prog} show")
    return call("mtab", argv, prog)


def cmd_path(argv, prog):
    if len(argv) != 1 or argv[0] not in ("lib", "api", "core"):
        say(f"usage: {prog} lib|api|core")
        return USAGE
    print(CORE if argv[0] == "core" else os.path.join(CORE, "queue"))
    return OK


def git(*args):
    return subprocess.run(["git", "-C", CORE, *args], capture_output=True, text=True)


def cmd_update(argv, prog):
    if argv:
        say(f"usage: {prog}")
        return USAGE
    if git("rev-parse", "--is-inside-work-tree").returncode:
        say(f"{CORE} is not a git checkout (bundles do not update)")
        return ERR
    before = git("rev-parse", "--short", "HEAD").stdout.strip()
    tries, last = 5, ""
    for i in range(1, tries + 1):
        r = git("pull", "--ff-only", "--quiet", "origin", "main")
        if r.returncode == 0:
            break
        last = (r.stderr or r.stdout).strip()
        if i < tries:
            time.sleep(i * 5)
    else:
        say(f"update failed (tried {tries} times), staying at {before}: {last[-300:]}")
        return ERR
    after = git("rev-parse", "--short", "HEAD").stdout.strip()
    say(f"already up to date: {after}" if after == before else f"updated: {before} -> {after}")
    return OK


def cmd_version(argv, prog):
    if argv:
        say(f"usage: {prog}")
        return USAGE
    print(version())
    return OK


def rsync_help(argv):
    return argv[:1]  # a later -h belongs to rsync itself (--human-readable)


SPEC_DOC = {
    "shell": ("<recipe> k=v... | --spec <JSON>", "shell line for run_task.sh (expanded for this machine)"),
    "done": ("<recipe> k=v... | --spec <JSON>", "0 when done, 1 not done, 2 bad spec, 5 data dir unreadable"),
    "resolve": ("<recipe> k=v...", "resolved spec (JSON, one line)"),
    "lookup": ("<key>", "find a task by key (experiment table first, then the queue) and print its spec (JSON)"),
    "outputs": ("<key>|--spec <JSON> [--sh]", "outputs of this task (JSON); --sh: shell line for archive_task.sh"),
    "collect": ("--json < input.json", "this machine's training state (for cross-version reads): prints one @@JSON line"),
}

RELAY_DOC = {"export": "relay plugin export: files to transfer, views, dirs to fetch (JSON)", "import": "relay plugin import check, places them in --dst (JSON)"}

