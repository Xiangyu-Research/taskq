#!/bin/bash
# ssh and scp for tests (fixture.use() and fixture.sh put this before the real ssh on PATH): tests never reach real machines;
# they fail at once (like unreachable, 255). A test that needs a fake ssh puts it earlier on PATH, or sets RELAY_SSH / TUNNEL_SSH.
echo "tests do not reach real machines: $(basename "$0") $*" >&2
exit 255
