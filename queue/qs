#!/usr/bin/env python3
"""Show the queues of machines with pueue groups (the config dir's machines.py; mtab.pueue_hosts): one line per task, ordered by
machine and group; finished ones only for the last 24 hours.

    taskq pueue-status              all (run on the hub; other machines over ssh)
    taskq pueue-status <machine>    only this machine
    taskq pueue-status --json       machine -> task list (used by monitor/health.py): status is for humans (such as "Failed (1)");
                                    programs read result (Success / Failed / Killed / ..., None while unfinished) and code (exit code, None when absent)
A running task in the wait group (fetch, archive, transfer) gets one extra line: the last line of its output.
Output of one task: pueue log <id> (pueue is that machine's pueue from the machine table, default ~/.local/bin/pueue).
"""
import datetime as dt
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cfg  # noqa: E402
cfg.use_config()
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "sites"))
import mtab as M  # noqa: E402
import common as C  # noqa: E402
from proto import EXIT  # noqa: E402

ME = M.whoami()


def pueue(machine, args):
    """Run pueue <args> on this machine (its pueue from the machine table; a leading ~ on other machines is left for that side) -> (exit code, stdout, stderr)."""
    p = M.machine(machine)["pueue"]
    if machine == ME:
        return C.run([M.expand(p), *args], timeout=60)
    return C.run(" ".join([p, *args]), M.MACHINES[machine]["ssh"], timeout=60)


def status(machine):
    rc, out, err = pueue(machine, ["status", "--json"])
    if rc:
        raise RuntimeError(err.strip() or "pueue does not respond")
    return json.loads(out)


def last_lines(machine, ids):
    """Task id -> the last line of its output."""
    if not ids:
        return {}
    try:
        _, out, _ = pueue(machine, ["log", "--json", "-l", "1", *map(str, ids)])
        return {int(k): (v.get("output") or "").strip().splitlines()[-1:] for k, v in json.loads(out).items()}
    except Exception:  # noqa: BLE001
        return {}


def tasks(d):
    rows = []
    for k in d["tasks"].values():
        (st, info), = k["status"].items() if isinstance(k["status"], dict) else [(k["status"], {})]
        res = info.get("result") if st == "Done" else None
        result = code = None
        if res is not None:
            result, code = (res, 0 if res == "Success" else None) if isinstance(res, str) else next(iter(res.items()))
            st = res if isinstance(res, str) else f"{result} ({code})"
            code = code if isinstance(code, int) else None
        rows.append({"id": k["id"], "group": k["group"], "status": st, "result": result, "code": code, "label": k.get("label") or "",
                     "deps": k.get("dependencies") or [], "start": info.get("start"), "end": info.get("end"),
                     "created_at": k.get("created_at"), "command": k["original_command"]})
    return sorted(rows, key=lambda r: (r["group"], r["id"]))


def main(argv=None):
    import argparse
    hosts = M.pueue_hosts()
    ap = argparse.ArgumentParser(description="queues of machines with pueue groups (read-only)")
    ap.add_argument("machines", nargs="*", metavar="MACHINE", help=f"only these ({', '.join(hosts)}); all without")
    ap.add_argument("--json", action="store_true", help="machine -> task list, one JSON line")
    a = ap.parse_args(argv)
    gone = [m for m in a.machines if m not in M.MACHINES]
    if gone:
        print(f"{ap.prog}: not in the machine table: {', '.join(gone)}", file=sys.stderr)
        return EXIT["gone"]
    bad = [m for m in a.machines if m not in hosts]
    if bad:
        ap.error(f"no pueue groups: {', '.join(bad)}")
    as_json = a.json
    machines = a.machines or hosts
    out = {}
    for m in machines:
        try:
            d = status(m)
            out[m] = {"groups": {g: v["status"] for g, v in d["groups"].items() if g != "default"}, "tasks": tasks(d)}
        except Exception as e:  # one unreachable machine does not affect the rest
            out[m] = {"error": str(e)}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
        return
    cut = dt.datetime.now() - dt.timedelta(hours=24)
    t = C.local_time
    for m, d in out.items():
        print(f"== {m}")
        if "error" in d:
            print("  unreachable: " + d["error"])
            continue
        last = last_lines(m, [r["id"] for r in d["tasks"] if r["group"] == "wait" and r["status"] == "Running"])
        for g, gst in sorted(d["groups"].items()):
            rows = [r for r in d["tasks"] if r["group"] == g and not (t(r["end"]) and t(r["end"]) < cut)]
            print(f"  [{g}]" + ("" if gst == "Running" else " (paused)") + ("" if rows else " empty"))
            for r in rows:
                _row(r)
                if last.get(r["id"]):
                    print(f"          ↳ {last[r['id']][0][:100]}")


def _row(r):
    when = " -> ".join(x.strftime("%m-%d %H:%M") for x in (C.local_time(r["start"]), C.local_time(r["end"])) if x)
    deps = f" waits {','.join(map(str, r['deps']))}" if r["deps"] and r["status"] == "Queued" else ""
    name = r["label"] or r["command"][:60]
    print(f"  {r['id']:>4}  {r['status']:<12} {name:<22}{deps:<8} {when}")


if __name__ == "__main__":
    sys.exit(main())
