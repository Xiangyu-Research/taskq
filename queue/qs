#!/usr/bin/env python3
"""查看各 pueue 机器（envs/machines.py）的队列（2026-10-16）：每个任务一行，按机器、组排列；已结束的只列最近 24 小时的。

    scripts/queue/qs            都看（在 box 上运行；别的机器经 ssh）
    scripts/queue/qs <机器>     只看一台（如 qs lab）
    scripts/queue/qs --json     机器 → 任务列表（scripts/monitor/health.py 用）：status 是给人看的（如 "Failed (1)"），
                                程序看 result（Success / Failed / Killed / …，没结束是 None）和 code（退出码，没有是 None）
wait 组里在跑的任务（等训完再拉回）下面多一行：输出的最后一行（fetch_task.sh 每小时记远端训到第几个 epoch）。
单个任务的输出：pueue log <编号>（别的机器上：ssh lab ~/.local/bin/pueue log <编号>）。
"""
import datetime as dt
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cfg  # noqa: E402
cfg.use_config()
import machines as M  # noqa: E402
import common as C  # noqa: E402  scripts/queue/common.py

PUEUE = os.path.expanduser("~/.local/bin/pueue")
ME = M.whoami()


def pueue(machine, args):
    """这台机器上跑 pueue <args> → (退出码, 标准输出, 标准错误)。"""
    if machine == ME:
        return C.run([PUEUE, *args], timeout=60)
    return C.run(" ".join(["~/.local/bin/pueue", *args]), M.MACHINES[machine]["ssh"], timeout=60)


def status(machine):
    rc, out, err = pueue(machine, ["status", "--json"])
    if rc:
        raise RuntimeError(err.strip() or "pueue 没有响应")
    return json.loads(out)


def last_lines(machine, ids):
    """任务编号 → 输出的最后一行。"""
    if not ids:
        return {}
    try:
        _, out, _ = pueue(machine, ["log", "--json", "-l", "1", *map(str, ids)])
        return {int(k): (v.get("output") or "").strip().splitlines()[-1:] for k, v in json.loads(out).items()}
    except Exception:  # noqa: BLE001
        return {}


def tasks(d):
    rows = []
    for k in d["tasks"].values():
        (st, info), = k["status"].items() if isinstance(k["status"], dict) else [(k["status"], {})]
        res = info.get("result") if st == "Done" else None
        result = code = None
        if res is not None:
            result, code = (res, 0 if res == "Success" else None) if isinstance(res, str) else next(iter(res.items()))
            st = res if isinstance(res, str) else f"{result} ({code})"
            code = code if isinstance(code, int) else None
        rows.append({"id": k["id"], "group": k["group"], "status": st, "result": result, "code": code, "label": k.get("label") or "",
                     "deps": k.get("dependencies") or [], "start": info.get("start"), "end": info.get("end"),
                     "created_at": k.get("created_at"), "command": k["original_command"]})
    return sorted(rows, key=lambda r: (r["group"], r["id"]))


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    hosts = M.names("pueue")
    machines = [a for a in args if a in hosts] or hosts
    out = {}
    for m in machines:
        try:
            d = status(m)
            out[m] = {"groups": {g: v["status"] for g, v in d["groups"].items() if g != "default"}, "tasks": tasks(d)}
        except Exception as e:  # 一台连不上不影响另一台
            out[m] = {"error": str(e)}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
        return
    cut = dt.datetime.now() - dt.timedelta(hours=24)
    t = C.local_time
    for m, d in out.items():
        print(f"== {m}")
        if "error" in d:
            print("  连不上：" + d["error"])
            continue
        last = last_lines(m, [r["id"] for r in d["tasks"] if r["group"] == "wait" and r["status"] == "Running"])
        for g, gst in sorted(d["groups"].items()):
            rows = [r for r in d["tasks"] if r["group"] == g and not (t(r["end"]) and t(r["end"]) < cut)]
            print(f"  [{g}]" + ("" if gst == "Running" else "（停着）") + ("" if rows else " 空"))
            for r in rows:
                _row(r)
                if last.get(r["id"]):
                    print(f"          ↳ {last[r['id']][0][:100]}")


def _row(r):
    when = "→".join(x.strftime("%m-%d %H:%M") for x in (C.local_time(r["start"]), C.local_time(r["end"])) if x)
    deps = f" 等 {','.join(map(str, r['deps']))}" if r["deps"] and r["status"] == "Queued" else ""
    name = r["label"] or r["command"][:60]
    print(f"  {r['id']:>4}  {r['status']:<12} {name:<22}{deps:<8} {when}")


if __name__ == "__main__":
    main()
