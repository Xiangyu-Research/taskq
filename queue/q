#!/bin/bash
# 往 pueue 队列里加一个任务（2026-10-16）：按组设好用哪张卡，工作目录是仓库根目录。
#   taskq pueue-add <组> [pueue add 的选项，如 --label 名字] -- '<命令>'（即 queue/q）
# 各机器有哪些组、每组用哪张卡、带哪些环境变量，写在 envs/machines.py（setup.sh 按它建组）；
# 没有卡的组 CUDA_VISIBLE_DEVICES 设为空（看不到卡）。每个任务都带上 envs/policy.py 的 OUTPUTS["env_script"] 设的数据路径。
# 表里这台机器有 code（box）时，任务的工作目录是按提交号的代码副本（先用 sync/snapshot.sh 更新到 GitHub 上的 main），
# 只跑已经推送的代码，以后的代码更新不改到这个任务；没有 code 时是表里的 repo。
# 例：taskq pueue-add gpu1 --label demo -- 'python3 train.py'
set -euo pipefail
PROG=${TASKQ_PROG:-q}
unset TASKQ_PROG
(( $# >= 2 )) && [[ $1 != -* && ${*: -1} != -- ]] || { echo "用法：$PROG <组> [pueue add 的选项] -- '<命令>'" >&2; exit 2; }
G=$1; shift
CORE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)  # 调度代码的根；使用者的仓库根 REPO（TASKQ_REPO，没设时同 cfg.py）
if [[ -n ${TASKQ_REPO:-} ]]; then REPO=$TASKQ_REPO; elif [[ $CORE == */scripts/taskq ]]; then REPO=${CORE%/scripts/taskq}; else eval "$(python3 "$CORE/queue/project.py" sh 2> /dev/null)"; REPO=${TASKQ_REPO:-$CORE}; fi
HERE=$REPO
E=$(python3 "$CORE/sites/mtab.py" q-env "$G" 2>&1 > /dev/null) || { echo "$PROG：${E#*：}" >&2; exit 2; }  # 先查组，再更新代码副本
SRC=$(python3 "$CORE/sites/mtab.py" get . repo) CODE=$(python3 "$CORE/sites/mtab.py" get . code)
if [[ -n $CODE ]]; then
    bash "$CORE/sync/snapshot.sh" "$SRC" 2>&1 || echo "$PROG：代码副本没更新到最新" >&2
    REPO=$(readlink -f "$CODE")
else
    REPO=$(readlink -f "$SRC")
fi
[[ -d $REPO ]] || { echo "$PROG：没有工作目录 $REPO" >&2; exit 2; }
echo "$PROG：任务用的代码 $(git -C "$REPO" rev-parse --short HEAD)（$REPO）"
ENV=$(TASKQ_REPO=$REPO python3 "$CORE/sites/mtab.py" q-env "$G") || exit 2
eval "$ENV"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export PATH="$CORE/bin:$PATH"  # 环境脚本和任务的命令里能用 taskq（cron 的 PATH 里没有 ~/.local/bin；同 run_task.sh）
ES=$(TASKQ_REPO=$REPO python3 "$CORE/queue/cfg.py" get env_script)
[[ -z $ES ]] || source "$REPO/$ES"
exec ~/.local/bin/pueue add -g "$G" -w "$REPO" "$@"
