#!/bin/bash
# 往 pueue 队列里加一个任务（2026-10-16）：按组设好用哪张卡，工作目录是仓库根目录。
#   q <组> [pueue add 的选项，如 --after 12、--label 名字、--stashed] -- '<命令>'
# 各机器有哪些组、每组用哪张卡、带哪些环境变量，写在 envs/machines.py（setup.sh 按它建组）；
# 没有卡的组 CUDA_VISIBLE_DEVICES 设为空（看不到卡）。每个任务都带上 envs/nnunet_paths.sh 设的数据路径。
# 例：q gpu1 --label t15men_f0 -- 'bash scripts/queue/train_task.sh 111 0 nnUNetTrainer_save10_n470'
set -euo pipefail
G=${1:?用法：q <组> [pueue add 选项] -- '<命令>'}; shift
REPO=$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel)
ENV=$(python3 "$REPO/envs/machines.py" q-env "$G") || exit 2
eval "$ENV"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
source "$REPO/envs/nnunet_paths.sh"  # 数据目录、nnUNet_raw / preprocessed / results：直接调 python 的分析任务也要用
exec ~/.local/bin/pueue add -g "$G" -w "$REPO" "$@"
