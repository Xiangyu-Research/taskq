#!/bin/bash
# Add a task to this machine's pueue manual group (machines.py's manual_groups): set the GPU from the group, working dir is this
# machine's repo.
#   taskq pueue-add <group> [pueue add options, such as --label NAME] -- '<command>'  (this is queue/q)
# Which groups each machine has, which GPU each uses and which env vars it gets are in the config dir's machines.py (setup.sh
# creates groups from it); a group without a GPU sets CUDA_VISIBLE_DEVICES empty (no GPU visible). Every task gets the env vars
# from policy.py's OUTPUTS["env_script"].
# To pin the code version and have the scheduler run it on an executor, use taskq add (bundle).
# Example: taskq pueue-add gpu1 --label demo -- 'python3 train.py'
set -euo pipefail
PROG=${TASKQ_PROG:-q}
unset TASKQ_PROG
(( $# >= 2 )) && [[ $1 != -* && ${*: -1} != -- ]] || { echo "usage: $PROG <group> [pueue add options] -- '<command>'" >&2; exit 2; }
G=$1; shift
CORE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)  # scheduler core root; the user repo root REPO (TASKQ_REPO, else as in cfg.py)
if [[ -n ${TASKQ_REPO:-} ]]; then REPO=$TASKQ_REPO; elif [[ $CORE == */scripts/taskq ]]; then REPO=${CORE%/scripts/taskq}; else eval "$(python3 "$CORE/queue/project.py" sh 2> /dev/null)"; REPO=${TASKQ_REPO:-$CORE}; fi
E=$(python3 "$CORE/sites/mtab.py" q-env "$G" 2>&1 > /dev/null) || { echo "$PROG: $E" >&2; exit 2; }
REPO=$(readlink -f "$(python3 "$CORE/sites/mtab.py" get . repo)")
[[ -d $REPO ]] || { echo "$PROG: no working dir $REPO (this machine's repo in machines.py)" >&2; exit 2; }
PUEUE=$(python3 "$CORE/sites/mtab.py" get . pueue)
ENV=$(TASKQ_REPO=$REPO python3 "$CORE/sites/mtab.py" q-env "$G") || exit 2
eval "$ENV"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export PATH="$CORE/bin:$PATH"  # env scripts and task commands can use taskq (cron PATH lacks ~/.local/bin; same as run_task.sh)
ES=$(TASKQ_REPO=$REPO python3 "$CORE/queue/cfg.py" get env_script)
[[ -z $ES ]] || source "$REPO/$ES"
exec "${PUEUE/#\~/$HOME}" add -g "$G" -w "$REPO" "$@"
